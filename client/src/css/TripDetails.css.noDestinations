/* Layout for the Travelers and Destinations columns */
.flex-container {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap; /* Allows sections to stack on smaller screens */
    justify-content: space-between;
    gap: 20px;
    margin: 20px 0;
    width: 100%;
}

.flex-container > div {
    background-color: #f1f1f1;
    flex: 1; /* Makes columns share space equally */
    min-width: 300px; /* Prevents columns from getting too narrow */
    text-align: center;
    /* Removed line-height: 75px to fix the "too big" display issue */
    padding: 20px; /* Use padding for spacing instead of line-height */
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

/* Header styling inside the flex boxes */
.flex-container h2 {
    font-size: 28px;
    margin-bottom: 15px;
    color: #333;
}

/* Paragraph styling for Travelers and Destinations list items */
.flex-container p {
    font-size: 20px;
    line-height: 1.5; /* Normal spacing for text */
    text-align: center; /* Changed from justify for better list appearance */
    margin: 10px 0;
}

.right-side {
    background-size: cover;
}

/* Buttons */
.addActivityBtn {
    color: rgb(255, 255, 255);
    background-color: rgba(38, 163, 217, 0.6);
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    margin-top: 10px;
}

.addActivityBtn:hover {
    background-color: rgba(29, 122, 162, 0.8);
}

.addDestinationBtn {
    color: rgb(255, 255, 255);
    background-color: rgba(38, 163, 217, 0.6);
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    margin-top: 10px;
}

.addDestinationBtn:hover {
    background-color: rgba(29, 122, 162, 0.8);
}

.destination-tag {
    background-color: rgba(255, 255, 255, 0.2);
    padding: 5px 12px;
    border-radius: 20px;
    margin-right: 10px;
    font-weight: bold;
    display: inline-block;
}

/* Ensure the main image doesn't blow out the layout */
#trip-main-img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 15px;
}
