import React, { useState, useEffect } from 'react';
import { useParams, Link } from 'react-router-dom'; // Added Link import
import ActivityBtn from '../components/ActivityBtn';
import '../css/TripDetails.css';

const TripDetails = ({ data, api_url, user }) => {
    const { id } = useParams();
    const [trip, setTrip] = useState({
        id: 0, title: '', description: '', img_url: '', 
        num_days: 0, start_date: '', end_date: '', total_cost: 0.00,
	// username: props.user.username
	username: user ? user.username : ''
    });
    
    const [activities, setActivities] = useState([]);
    const [destinations, setDestinations] = useState([]);
    const [travelers, setTravelers] = useState([]); // STEP 10: New state variable

    useEffect(() => {
        // 1. Find the specific trip from the trips state
        const result = data.find(item => item.id === parseInt(id));
        if (result) {
            setTrip(result);
        }

        // 2. Fetch Activities
        const fetchActivities = async () => {
            try {
                const response = await fetch(`${api_url}/api/activities/${id}`);
                const json = await response.json();
                setActivities(json);
            } catch (error) {
                console.error("Could not fetch activities:", error);
            }
        };

        // 3. Fetch Linked Destinations
        const fetchDestinations = async () => {
            try {
                const response = await fetch(`${api_url}/api/trips-destinations/destinations/${id}`);
                const json = await response.json();
                setDestinations(json);
            } catch (error) {
                console.error("Could not fetch destinations:", error);
            }
        };

        // STEP 10: Fetch Travelers associated with this trip
        const fetchTravelers = async () => {
            try {
                const response = await fetch(`${api_url}/api/users-trips/users/${id}`);
                const travelersJson = await response.json();
                setTravelers(travelersJson);
            } catch (error) {
                console.error("Could not fetch travelers:", error);
            }
        };

        fetchActivities();
        fetchDestinations();
        fetchTravelers(); // Call it here
    }, [data, id, api_url]);

    return (
        <div className="TripDetails">
            <main id="trip-details-main">
                <div id="trip-header">
                    <img src={trip.img_url} alt={trip.title} id="trip-main-img" />
                    <div id="trip-title-card">
                        <h1>{trip.title}</h1>
                        <p>{trip.description}</p>
                    </div>
                </div>

                <div className="travelers-section">
                    <h2>Travelers</h2>
                    <div className='travelers'>
                        {
                            travelers && travelers.length > 0 ?
                            travelers.map((traveler, index) => 
                                <p key={index} style={{ textAlign: 'center', lineHeight: 0, paddingTop: 20 }}>
                                    {traveler.username}
                                </p>
                            ) : ''
                        }
                        <br/>
                        {/* This Link allows navigation to the Add User page from the Trip Details tab */}
                        <Link to={'/users/add/' + id }><button className='addActivityBtn'>+ Add Traveler</button></Link>
                    </div>
                </div>

                <div className="activities-container">
                    <h2>Planned Activities</h2>
                    <div className="activities-grid">
                        {activities && activities.length > 0 ? (
                            activities.map((act) => (
                                <ActivityBtn 
                                    key={act.id} 
                                    id={act.id} 
                                    activity={act.activity} 
                                    num_votes={act.num_votes}
                                    api_url={api_url} 
                                />
                            ))
                        ) : (
                            <p>No activities yet!</p>
                        )}
                    </div>
                    
                    <div className="details-controls">
                        <Link to={`/activity/create/${id}`}>
                            <button className="addActivityBtn">+ Add Activity</button>
                        </Link>
                        <Link to={`/destination/new/${id}`}>
                            <button className="addDestBtn">+ Add Destination</button>
                        </Link>
                    </div>
                </div>
            </main>
        </div>
    );
};

export default TripDetails;
